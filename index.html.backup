<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Helium IoT | NJ Municipalities</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
:root{font-family:system-ui,-apple-system,sans-serif;color:#17243a}*{box-sizing:border-box}body{margin:0}header{background:#15243a;color:white;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:12px}header h1{font-size:19px;margin:0}header small{color:#c7d6e8}.layout{display:grid;grid-template-columns:310px 1fr;height:calc(100vh - 65px)}aside{padding:20px;background:#f7f9fc;overflow:auto;border-right:1px solid #dbe3ed}#map{height:100%;width:100%}label{display:block;font-size:13px;font-weight:700;margin:17px 0 7px}select,button{width:100%;border:1px solid #bac7d7;border-radius:8px;padding:10px;background:white;font:inherit}button{cursor:pointer;margin-top:10px}button:hover{background:#eaf0f7}.stat{background:white;border:1px solid #e0e6ee;padding:12px;border-radius:9px;margin-top:12px}.stat strong{font-size:23px;display:block}.stat span{font-size:12px;color:#53657d}.hint{font-size:12px;line-height:1.6;color:#526177}.error{color:#a02b2b}.legend{background:white;padding:9px;border-radius:7px;box-shadow:0 1px 8px #0002;font-size:12px}.swatch{display:inline-block;width:14px;height:12px;background:#ed5656;border:1px solid #a92727;vertical-align:middle;margin-right:6px}@media(max-width:700px){.layout{grid-template-columns:1fr;grid-template-rows:auto minmax(420px,1fr);height:auto}aside{padding:12px}#map{height:65vh}header{padding:12px}}
</style></head><body>
<header><div><h1>Helium IoT · New Jersey</h1><small>Registered hotspot assertions · not verified RF coverage</small></div><small>No API key · No payment card</small></header>
<div class="layout"><aside>
<label for="town">Municipality</label><select id="town"><option value="">All 12 municipalities</option></select>
<label for="base">Basemap</label><select id="base"><option value="osm">OpenStreetMap Standard</option></select>
<label for="dataSource">Dataset</label><select id="dataSource"><option value="assertions">Registered hotspots (not verified)</option><option value="verified">Verified activity (optional dataset)</option></select>
<label for="minCount">Minimum registrations per cell: <strong id="minCountValue">1</strong></label><input id="minCount" type="range" min="1" max="20" step="1" value="1" style="width:100%">
<label><input id="showHex" type="checkbox" checked> Show H3 hotspot hexagons</label>
<label><input id="showBounds" type="checkbox" checked> Show municipality boundaries</label>
<button id="reset">Zoom to study area</button>
<div class="stat"><strong id="hexCount">—</strong><span>Unique H3 cells in selected area</span></div>
<div class="stat"><strong id="hotspotCount">—</strong><span>Registration records in selected area</span></div>
<p id="freshness" class="hint"></p><p id="status" class="hint">Loading local datasets…</p>
<p class="hint"><b>Important:</b> Red cells represent asserted gateway locations, <em>not</em> verified LoRaWAN signal coverage. No real-time reachability is inferred.</p>
<p class="hint">Map data © OpenStreetMap contributors. Tile usage subject to OpenStreetMap policies.</p>
</aside><main id="map" aria-label="Interactive map"></main></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/h3-js@4.2.1/dist/h3-js.umd.js"></script>
<script>
'use strict';
const NAMES=['Carlstadt','Cliffside Park','East Rutherford','Edgewater','Fairview','Lyndhurst','North Arlington','Passaic','Ridgefield','Rutherford','Wallington','Wood-Ridge'];
const NJ_BOUNDS=[[40.74,-74.23],[40.91,-73.94]];
const map=L.map('map',{preferCanvas:true}).fitBounds(NJ_BOUNDS);
const tileLayer=L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',{
  maxZoom:19,
  attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
}).addTo(map);
const hexLayer=L.layerGroup().addTo(map),boundaryLayer=L.geoJSON(null,{style:{color:'#235eab',weight:2,fillOpacity:.035},onEachFeature:(feature,layer)=>layer.bindTooltip(feature.properties.name||'Municipality')}).addTo(map);
const townEl=document.getElementById('town'),statusEl=document.getElementById('status');
NAMES.forEach(n=>townEl.add(new Option(n,n)));
let boundaries=[],cells=[],assertions=[],verified=[],assertMeta={},verifiedMeta={};
const datasetEl=document.getElementById('dataSource'),minCountEl=document.getElementById('minCount');
function selectedMetadata(){return datasetEl.value==='verified'?verifiedMeta:assertMeta;}
function updateFreshness(){const m=selectedMetadata();const label=datasetEl.value==='verified'?'Verified activity':'Registered-hotspot directory';document.getElementById('freshness').textContent=label+' · Retrieved: '+(m.retrieved_utc||m.observed_utc||'unknown')+' · '+(m.complete===true?'Full source fetch confirmed': 'Completeness not confirmed')+(m.source?' · '+m.source:'');}
function switchDataset(){cells=datasetEl.value==='verified'?verified:assertions;minCountEl.disabled=datasetEl.value==='verified';updateFreshness();render();}
function normalizeName(feature){const p=feature.properties||{};return String(p.name||p.NAME||p.NAMELSAD||'').replace(/\s+(borough|city|township|town|village)$/i,'').trim();}
function selectTown(name){const f=boundaries.find(x=>normalizeName(x)===name);if(!f)return null;return L.geoJSON(f).getBounds();}
function pointInTown(lat,lng,name){if(!name)return true;const feature=boundaries.find(x=>normalizeName(x)===name);if(!feature)return false;return pointInGeometry([lng,lat],feature.geometry);}
function inRing(point,ring){let inside=false;const [x,y]=point;for(let i=0,j=ring.length-1;i<ring.length;j=i++){const a=ring[i],b=ring[j];if(((a[1]>y)!==(b[1]>y))&&(x<(b[0]-a[0])*(y-a[1])/(b[1]-a[1])+a[0]))inside=!inside;}return inside;}
function inPolygon(p,rings){return rings.length>0&&inRing(p,rings[0])&&!rings.slice(1).some(r=>inRing(p,r));}
function pointInGeometry(p,g){if(!g)return false;if(g.type==='Polygon')return inPolygon(p,g.coordinates);if(g.type==='MultiPolygon')return g.coordinates.some(poly=>inPolygon(p,poly));return false;}
function render(){hexLayer.clearLayers();const town=townEl.value;let n=0,count=0;for(const c of cells){const [lat,lng]=h3.cellToLatLng(c.h3);if(!pointInTown(lat,lng,town))continue;if(datasetEl.value==='assertions' && (c.count||1)<Number(minCountEl.value))continue;n++;count+=c.count||1;if(document.getElementById('showHex').checked){const polygon=L.polygon(h3.cellToBoundary(c.h3),{color:'#ba2929',weight:1,fillColor:'#f04c4c',fillOpacity:.36});polygon.bindPopup(`<b>H3 cell</b>: ${c.h3}<br><b>${datasetEl.value==='verified'?'Source observations':'Registered hotspots'}</b>: ${c.count||1}<br><small>${datasetEl.value==='verified'?'Review source metadata and observation dates':'Not verified radio coverage; density filter is NOT an activity filter'}</small>`);polygon.addTo(hexLayer);}}document.getElementById('hexCount').textContent=n.toLocaleString();document.getElementById('hotspotCount').textContent=count.toLocaleString();}
townEl.addEventListener('change',()=>{const b=selectTown(townEl.value);if(b&&b.isValid())map.fitBounds(b.pad(.1));else map.fitBounds(NJ_BOUNDS);render();});
document.getElementById('showHex').addEventListener('change',render);
document.getElementById('showBounds').addEventListener('change',e=>e.target.checked?boundaryLayer.addTo(map):map.removeLayer(boundaryLayer));
datasetEl.addEventListener('change',switchDataset);minCountEl.addEventListener('input',()=>{document.getElementById('minCountValue').textContent=minCountEl.value;render();});
document.getElementById('reset').addEventListener('click',()=>{townEl.value='';map.fitBounds(NJ_BOUNDS);render();});

async function loadJSON(url){const res=await fetch(url,{cache:'no-store'});if(!res.ok)throw Error(`${url}: HTTP ${res.status}`);return res.json();}
(async()=>{let messages=[];try{const geo=await loadJSON('./data/municipalities.geojson');boundaries=(geo.features||[]).filter(f=>NAMES.includes(normalizeName(f)));boundaryLayer.addData({type:'FeatureCollection',features:boundaries});if(boundaries.length!==NAMES.length)messages.push(`Boundaries loaded for ${boundaries.length}/12 municipalities.`);if(boundaries.length){const b=boundaryLayer.getBounds();if(b.isValid())map.fitBounds(b.pad(.06));}}catch(e){messages.push('Municipality boundaries missing. Run the data preparation script.');console.warn(e);}try{const data=await loadJSON('./data/hexes.json');assertMeta=data.metadata||{};assertions=(Array.isArray(data)?data:data.cells||[]).filter(c=>typeof c.h3==='string'&&h3.isValidCell(c.h3));messages.push(`${assertions.length} registered-hotspot H3 cells loaded.`);if(assertMeta.complete!==true)messages.push('WARNING: source download not confirmed complete.');}catch(e){messages.push('Hexagon data missing. Run the Helium downloader.');console.warn(e);}try{const vd=await loadJSON('./data/verified_hexes.json');verifiedMeta=vd.metadata||{};verified=(vd.cells||[]).filter(c=>typeof c.h3==='string'&&h3.isValidCell(c.h3));}catch(e){console.info('No independent verified-activity dataset provided.');}if(!verified.length){datasetEl.options[1].disabled=true;datasetEl.options[1].text='Verified activity (not configured)';}statusEl.textContent=messages.join(' ');if(!boundaries.length||!assertions.length)statusEl.classList.add('error');switchDataset();})();
</script></body></html>
